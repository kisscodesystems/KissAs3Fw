    public function getCategoryList():Array
    {
      var categoryList:Array = new Array();
      for (var key:String in emojiNames)
      {
        categoryList.push(key);
      }
      return categoryList;
    }
    public function getEmojiList(category:String):Array
    {
      if (emojiNames[category] == undefined) return new Array();
      var emojiList:Array = new Array();
      for (var i:int = 0; i < emojiNames[category].length; i++)
      {
        emojiList.push(emojiNames[category][i]);
      }
      return emojiList;
    }
    public function getNewBitmapData(emojiType:String, emojiSize:int = 32):BitmapData
    {
      var vectorDrawings:VectorDrawings = emojiDrawings[emojiType] as VectorDrawings;
      if (vectorDrawings == null)
      {
        return new BitmapData(emojiSize, emojiSize, true, 0x00ffffff);
      }
      return vectorDrawings.getNewBitmapData(emojiType, emojiSize);
    }
    /**
     * Destroys this object and frees up everything.
     */
    public function destroy():void
    {
      application.trace("<EmojiManager destroy> called.", 1);
      if (drawings != null)
      {
        drawings.destroy();
      }
      emojiNames = null;
      emojiDrawings = null;
      drawings = null;
      files = null;
      application = null;
    }
